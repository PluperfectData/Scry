{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Scry": {
    "DataDirectory": "data"
  },
  "Jwt": {
    "Issuer": "scry",
    "AccessCookieName": "scry_sid",
    "RefreshCookieName": "scry_rt"
  }
}
