# Scry in Docker over HTTPS: its site and its API. Caddy makes each certificate from its own authority, which the
# launcher asks this computer to trust. Paths that are not files get index.html, since the site routes in the browser.
{
	skip_install_trust
	auto_https disable_redirects
	# A browser sends no server name to an IP address, so this picks the certificate.
	default_sni 127.0.0.1
	# A plain http request on an https port, as Docker Desktop's port links send, is redirected to https.
	servers {
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

# Docker Desktop's links name 127.0.0.1, where the site's cookies and the API's allowed origin don't apply.
https://127.0.0.1:6160, https://127.0.0.1:6161 {
	tls internal
	redir https://localhost:{http.request.port}{uri} 308
}

https://localhost:6160 {
	tls internal
	root * /srv
	encode gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

https://localhost:6161 {
	tls internal
	reverse_proxy scry-api:6161
}
